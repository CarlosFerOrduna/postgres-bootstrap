# --- Server (docker-compose.yml) -------------------------------------------

# Superuser created by the postgres image on first boot.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Image for the server and the snapshot tooling. Keep it >= your sources' version.
POSTGRES_IMAGE=postgres:16.3

# Host port to publish.
PG_PORT=5432

# --- Snapshots (scripts/pull.sh, scripts/restore.sh) -----------------------

# Databases pull.sh dumps when --db is not given (comma-separated).
DATABASES=app_db

# Owner role per database for restore.sh (db:role, comma-separated).
# Unlisted databases stay owned by POSTGRES_USER.
# DB_OWNERS=app_db:app_user

# Tables whose data pull.sh skips by default (comma-separated; heavy or PII tables).
# Override per run with --exclude-table-data or --include-all-data.
# EXCLUDE_TABLE_DATA=audit_log
